# Copy to `.env` (which is gitignored) and fill in real values. NEVER commit `.env`.
# Real secrets must only ever live in `.env` or the host's environment, never in code.

# --- Stage 1: ML pipeline (active) -------------------------------------------------------
# Read from the process environment (export/set them or use your shell profile);
# `.env` loading arrives with the backend's settings in Stage 2.

# Reproducibility seed for splits and training.
COPILOT_ML_SEED=42
# Override the ML working directory (datasets/, models/, reports/). Default: the `ml/` folder.
# COPILOT_ML_HOME=

# --- Stage 2: backend + PostgreSQL (active) ------------------------------------------------
# Native PostgreSQL install; role + databases created by infrastructure/scripts/setup-db.ps1.

DATABASE_URL=postgresql+asyncpg://copilot:CHANGE_ME@localhost:5432/copilot_dev
TEST_DATABASE_URL=postgresql+asyncpg://copilot:CHANGE_ME@localhost:5432/copilot_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME
JWT_ACCESS_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Requests per window to POST /api/v1/analyze/url, per client IP. slowapi syntax.
# RATE_LIMIT_ANALYZE=20/minute

# --- Stage 3: LLM + vector store (active) --------------------------------------------------
# LLM: Hugging Face Inference Providers (OpenAI-compatible router). Generate a fine-grained
# token with "Make calls to Inference Providers" permission at hf.co/settings/tokens.
# Report generation degrades to report=null (rather than the app failing to start) if unset.
HF_TOKEN=
# openai/gpt-oss-120b: Apache 2.0, native structured-output/tool-calling support. The smaller
# openai/gpt-oss-20b is cheaper and fine for Stage 3's report generation alone, but live-testing
# showed it fails Stage 4's multi-round agent tool-calling loop over half the time via this
# router (a router-side parse bug, not a prompt issue - see backend/app/llm/client.py).
HF_MODEL=openai/gpt-oss-120b

# Vector store: local on-disk Qdrant by default (no server, no Docker). Set QDRANT_URL to point
# at a real Qdrant server instead (e.g. when the Stage 4 MCP server needs concurrent access).
# QDRANT_URL=http://localhost:6333

# --- Stage 4: threat intelligence (active) -------------------------------------------------
# URLhaus (abuse.ch): free Auth-Key at https://auth.abuse.ch/. Lookup-only - never submits URLs.
# Threat-intel evidence degrades to status="unavailable" (rather than failing the analysis) if
# unset, rate-limited, or unreachable.
URLHAUS_AUTH_KEY=

# --- Reserved for later stages (not read by any code yet) ---------------------------------

# GOOGLE_SAFE_BROWSING_API_KEY=
# ABUSEIPDB_API_KEY=
